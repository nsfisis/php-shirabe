{
    "name": "shirabe/e2e-phpcs-installer",
    "description": "E2E fixture project: let dealerdirect/phpcodesniffer-composer-installer register a PHPCS standard.",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "dealerdirect/phpcodesniffer-composer-installer",
                "version": "1.2.1",
                "type": "composer-plugin",
                "license": "MIT",
                "autoload": {
                    "psr-4": {
                        "PHPCSStandards\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\": "src/"
                    }
                },
                "require": {
                    "php": ">=5.4",
                    "composer-plugin-api": "^2.2",
                    "squizlabs/php_codesniffer": "^3.1.0 || ^4.0"
                },
                "extra": {
                    "class": "PHPCSStandards\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\Plugin"
                },
                "dist": {
                    "type": "path",
                    "url": "../ext/phpcodesniffer-composer-installer-1.2.1"
                },
                "transport-options": {
                    "symlink": false
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "squizlabs/php_codesniffer",
                "version": "4.0.4",
                "type": "library",
                "license": "BSD-3-Clause",
                "require": {
                    "php": ">=7.2.0",
                    "ext-libxml": "*",
                    "ext-simplexml": "*",
                    "ext-tokenizer": "*",
                    "ext-xmlwriter": "*"
                },
                "bin": [
                    "bin/phpcbf",
                    "bin/phpcs"
                ],
                "dist": {
                    "type": "path",
                    "url": "../ext/php_codesniffer-4.0.4"
                },
                "transport-options": {
                    "symlink": false
                }
            }
        },
        {
            "type": "path",
            "url": "../packages/*",
            "options": {
                "symlink": false
            }
        },
        {
            "packagist.org": false
        }
    ],
    "require": {
        "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
        "acme/coding-standard": "1.0.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
