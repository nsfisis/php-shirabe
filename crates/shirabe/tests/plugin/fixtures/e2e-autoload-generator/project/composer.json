{
    "name": "shirabe/e2e-autoload-generator",
    "description": "E2E fixture project: record what the AutoloadGenerator Composer hands out reports to a plugin.",
    "repositories": [
        {
            "type": "path",
            "url": "../plugin",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../packages/*",
            "options": {
                "symlink": false
            }
        },
        {
            "packagist.org": false
        }
    ],
    "require": {
        "shirabe-test/autoload-generator-probe": "1.0.0",
        "acme/lib-a": "1.0.0"
    },
    "require-dev": {
        "acme/dev-tool": "1.0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "classes/"
        ]
    },
    "config": {
        "allow-plugins": {
            "shirabe-test/autoload-generator-probe": true
        }
    }
}
