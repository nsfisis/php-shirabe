{
    "name": "shirabe/e2e-buffer-io",
    "description": "E2E fixture project: record what a plugin's own BufferIO captures.",
    "repositories": [
        {
            "type": "path",
            "url": "../plugin",
            "options": {
                "symlink": false
            }
        },
        {
            "packagist.org": false
        }
    ],
    "require": {
        "shirabe-test/buffer-io-probe": "1.0.0"
    },
    "config": {
        "allow-plugins": {
            "shirabe-test/buffer-io-probe": true
        }
    }
}
