{
    "name": "shirabe/e2e-jetpack-autoloader",
    "description": "E2E fixture project: let automattic/jetpack-autoloader generate its autoloader after Composer's own dump.",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "automattic/jetpack-autoloader",
                "version": "5.0.22",
                "type": "composer-plugin",
                "license": [
                    "GPL-2.0-or-later"
                ],
                "autoload": {
                    "classmap": [
                        "src/AutoloadGenerator.php"
                    ],
                    "psr-4": {
                        "Automattic\\Jetpack\\Autoloader\\": "src"
                    }
                },
                "require": {
                    "php": ">=7.2",
                    "composer-plugin-api": "^2.2"
                },
                "extra": {
                    "class": "Automattic\\Jetpack\\Autoloader\\CustomAutoloaderPlugin"
                },
                "dist": {
                    "type": "path",
                    "url": "../ext/jetpack-autoloader-5.0.22"
                },
                "transport-options": {
                    "symlink": false
                }
            }
        },
        {
            "type": "path",
            "url": "../packages/*",
            "options": {
                "symlink": false
            }
        },
        {
            "packagist.org": false
        }
    ],
    "require": {
        "automattic/jetpack-autoloader": "5.0.22",
        "acme/hello": "1.0.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "autoloader-suffix": "E2E",
        "allow-plugins": {
            "automattic/jetpack-autoloader": true
        }
    }
}
