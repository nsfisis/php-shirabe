# The Rust functions answering the instance methods of each worker-side class that forwards any,
# for scripts/plugin-stub-generator/surface-manifest. One FQCN per line, followed by the
# functions whose `match method_name` arms serve an entity handed out under that class, or by
# `-` for a class no entity is handed out as (an abstract base, or a class whose entities are
# always handed out under a subclass), or by `forwarding` for a class whose dispatch is generated
# into crates/shirabe/src/php_worker/rpc/forwarding.rs.
Composer\Autoload\AutoloadGenerator forwarding
Composer\Composer forwarding
Composer\Config forwarding
Composer\DependencyResolver\LocalRepoTransaction forwarding
Composer\DependencyResolver\Operation\InstallOperation forwarding
Composer\DependencyResolver\Operation\MarkAliasInstalledOperation forwarding
Composer\DependencyResolver\Operation\MarkAliasUninstalledOperation forwarding
Composer\DependencyResolver\Operation\SolverOperation forwarding
Composer\DependencyResolver\Operation\UninstallOperation forwarding
Composer\DependencyResolver\Operation\UpdateOperation forwarding
Composer\DependencyResolver\Transaction forwarding
Composer\Downloader\DownloadManager forwarding
Composer\EventDispatcher\Event dispatch_event_method
Composer\EventDispatcher\EventDispatcher forwarding
Composer\IO\BaseIO forwarding
Composer\IO\BufferIO forwarding
Composer\IO\ConsoleIO forwarding
Composer\IO\NullIO forwarding
Composer\Installer\InstallationManager forwarding
Composer\Installer\InstallerEvent dispatch_event_method
Composer\Installer\PackageEvent dispatch_event_method
Composer\Package\AliasPackage forwarding
Composer\Package\BasePackage forwarding
Composer\Package\CompleteAliasPackage forwarding
Composer\Package\CompletePackage forwarding
Composer\Package\Locker forwarding
Composer\Package\Package forwarding
Composer\Package\RootAliasPackage forwarding
Composer\Package\RootPackage forwarding
Composer\PartialComposer forwarding
Composer\Plugin\CommandEvent dispatch_event_method
Composer\Plugin\PostFileDownloadEvent dispatch_event_method dispatch_post_file_download_event_method
Composer\Plugin\PreCommandRunEvent dispatch_event_method
Composer\Plugin\PreFileDownloadEvent dispatch_event_method dispatch_pre_file_download_event_method
Composer\Plugin\PrePoolCreateEvent dispatch_event_method dispatch_pre_pool_create_event_method
Composer\Repository\ArrayRepository forwarding
Composer\Repository\FilesystemRepository forwarding
Composer\Repository\InstalledArrayRepository forwarding
Composer\Repository\InstalledFilesystemRepository forwarding
Composer\Repository\LockArrayRepository forwarding
