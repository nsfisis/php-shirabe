# The Rust functions answering the instance methods of each worker-side class that forwards any,
# for scripts/plugin-stub-generator/surface-manifest. One FQCN per line, followed by the
# functions whose `match method_name` arms serve an entity handed out under that class, or by
# `-` for a class no entity is handed out as (an abstract base, or a class whose entities are
# always handed out under a subclass), or by `forwarding` for a class whose dispatch is generated
# into crates/shirabe/src/php_worker/rpc/forwarding.rs.
Composer\Autoload\AutoloadGenerator dispatch_autoload_generator_method
Composer\Composer dispatch_composer_method
Composer\Config dispatch_config_method
Composer\DependencyResolver\LocalRepoTransaction dispatch_transaction_method
Composer\DependencyResolver\Operation\InstallOperation dispatch_operation_method
Composer\DependencyResolver\Operation\MarkAliasInstalledOperation dispatch_operation_method
Composer\DependencyResolver\Operation\MarkAliasUninstalledOperation dispatch_operation_method
Composer\DependencyResolver\Operation\SolverOperation -
Composer\DependencyResolver\Operation\UninstallOperation dispatch_operation_method
Composer\DependencyResolver\Operation\UpdateOperation dispatch_operation_method
Composer\DependencyResolver\Transaction dispatch_transaction_method
Composer\Downloader\DownloadManager dispatch_download_manager_method
Composer\EventDispatcher\Event dispatch_event_method
Composer\EventDispatcher\EventDispatcher dispatch_event_dispatcher_method
Composer\IO\BaseIO -
Composer\IO\BufferIO dispatch_io_method
Composer\IO\ConsoleIO dispatch_io_method
Composer\IO\NullIO dispatch_io_method
Composer\Installer\InstallationManager dispatch_installation_manager_method
Composer\Installer\InstallerEvent dispatch_event_method
Composer\Installer\PackageEvent dispatch_event_method
Composer\Package\AliasPackage dispatch_package_method dispatch_package_getter dispatch_complete_package_getter
Composer\Package\BasePackage -
Composer\Package\CompleteAliasPackage dispatch_package_method dispatch_package_getter dispatch_complete_package_getter
Composer\Package\CompletePackage dispatch_package_method dispatch_package_getter dispatch_complete_package_getter
Composer\Package\Locker forwarding
Composer\Package\Package dispatch_package_method dispatch_package_getter dispatch_complete_package_getter
Composer\Package\RootAliasPackage dispatch_package_method dispatch_package_getter dispatch_complete_package_getter
Composer\Package\RootPackage dispatch_package_method dispatch_package_getter dispatch_complete_package_getter
Composer\PartialComposer -
Composer\Plugin\CommandEvent dispatch_event_method
Composer\Plugin\PostFileDownloadEvent dispatch_event_method dispatch_post_file_download_event_method
Composer\Plugin\PreCommandRunEvent dispatch_event_method
Composer\Plugin\PreFileDownloadEvent dispatch_event_method dispatch_pre_file_download_event_method
Composer\Plugin\PrePoolCreateEvent dispatch_event_method dispatch_pre_pool_create_event_method
Composer\Repository\ArrayRepository -
Composer\Repository\FilesystemRepository -
Composer\Repository\InstalledArrayRepository dispatch_repository_method
Composer\Repository\InstalledFilesystemRepository dispatch_repository_method
Composer\Repository\LockArrayRepository dispatch_repository_method
Composer\Repository\RepositoryManager dispatch_repository_manager_method
Composer\Repository\WritableArrayRepository -
Composer\Script\Event dispatch_event_method
Composer\Util\Filesystem dispatch_filesystem_method
Composer\Util\HttpDownloader dispatch_http_downloader_method
Composer\Util\ProcessExecutor dispatch_process_executor_method
Shirabe\RustCapablePluginStub dispatch_plugin_method
Shirabe\RustPluginStub dispatch_plugin_method
Shirabe\RustProcessStub forwarding
