#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

use Shirabe\PluginStubGenerator\GenerationError;
use Shirabe\PluginStubGenerator\SurfaceManifest;

$repoRoot = dirname(__DIR__, 2);
$manifestPath = $repoRoot . '/crates/shirabe/src/php_worker/rpc/surface.tsv';
$forwardingPath = $repoRoot . '/crates/shirabe/src/php_worker/rpc/forwarding.rs';
$check = false;

foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--check') {
        $check = true;
    } else {
        fwrite(STDERR, "usage: surface-manifest [--check]\n");
        exit(2);
    }
}

$dispatchers = [];
foreach (file(__DIR__ . '/dispatchers.list', FILE_IGNORE_NEW_LINES) as $line) {
    $line = trim($line);
    if ($line === '' || str_starts_with($line, '#')) {
        continue;
    }
    $fields = preg_split('/\s+/', $line);
    $fqcn = array_shift($fields);
    if ($fields === [] || isset($dispatchers[$fqcn])) {
        fwrite(STDERR, "error: malformed or duplicate entry in dispatchers.list: $line\n");
        exit(1);
    }
    $dispatchers[$fqcn] = match ($fields) {
        ['-'] => [],
        ['forwarding'] => null,
        default => $fields,
    };
}

$phpDir = $repoRoot . '/crates/shirabe-php-rpc/php';
$manifest = new SurfaceManifest(
    [$phpDir . '/stubs', $phpDir . '/runtime'],
    $repoRoot . '/crates/shirabe/src',
    $dispatchers,
    [$phpDir . '/guards'],
);
try {
    $rendered = $manifest->render();
} catch (GenerationError $e) {
    foreach ($e->errors as $error) {
        fwrite(STDERR, "error: $error\n");
    }
    exit(1);
}

$outputs = [$manifestPath => $rendered['manifest'], $forwardingPath => $rendered['forwarding']];
if ($check) {
    $stale = false;
    foreach ($outputs as $path => $content) {
        if (@file_get_contents($path) !== $content) {
            fwrite(STDERR, "error: stale output (regenerate): $path\n");
            $stale = true;
        }
    }
    exit($stale ? 1 : 0);
}
foreach ($outputs as $path => $content) {
    file_put_contents($path, $content);
    fwrite(STDERR, "written to $path\n");
}
