#!/usr/bin/env bash
#
# Packages a release build of the Shirabe executable into
# `<output dir>/shirabe-<version>-<target>.tar.gz`, and writes the SHA-256 checksum of the archive
# next to it. The archive has LICENSE.md with the section generated by
# scripts/release/third-party-licenses appended, README.md, and every file that the two reach
# through relative Markdown links, at the same paths as in the repository so that the links resolve.
#
# Usage: scripts/release/package <target> <path to the shirabe executable> <third-party licenses section> <output dir>

set -euo pipefail

if [[ $# -ne 4 ]]; then
    echo "usage: $0 <target> <path to the shirabe executable> <third-party licenses section> <output dir>" >&2
    exit 2
fi

target="$1"
bin="$2"
third_party_licenses="$3"
out_dir="$4"
repo_root="$(dirname "$0")/../.."

version="$(cargo metadata --no-deps --format-version 1 --manifest-path "$repo_root/Cargo.toml" \
    | jq --raw-output '.packages[] | select(.name == "shirabe") | .version')"
name="shirabe-$version-$target"

mkdir -p "$out_dir/$name"
cp "$bin" "$out_dir/$name/shirabe"
{
    cat "$repo_root/LICENSE.md"
    echo
    cat "$third_party_licenses"
} > "$out_dir/$name/LICENSE.md"

# Copies the files reachable from README.md and LICENSE.md through relative links, following links
# in the Markdown files it copies. A link to a file that does not exist fails the packaging. Written
# for the Bash 3.2 and BSD tools of macOS.
normalize_path() {
    local IFS=/ part
    local -a parts=()
    for part in $1; do
        case "$part" in
            '' | .) ;;
            ..)
                if [[ ${#parts[@]} -eq 0 ]]; then
                    return 1
                fi
                unset 'parts[${#parts[@]}-1]'
                ;;
            *) parts+=("$part") ;;
        esac
    done
    echo "${parts[*]}"
}

queue=(README.md LICENSE.md)
visited=$'\n'
i=0
while [[ $i -lt ${#queue[@]} ]]; do
    file="${queue[$i]}"
    i=$((i + 1))
    [[ "$visited" == *$'\n'"$file"$'\n'* ]] && continue
    visited+="$file"$'\n'
    if [[ ! -f "$repo_root/$file" ]]; then
        echo "broken link to $file" >&2
        exit 1
    fi
    if [[ "$file" != LICENSE.md ]]; then
        mkdir -p "$out_dir/$name/$(dirname "$file")"
        cp "$repo_root/$file" "$out_dir/$name/$file"
    fi
    [[ "$file" == *.md ]] || continue
    dir="$(dirname "$file")"
    while IFS= read -r link; do
        case "$link" in
            http://* | https://* | mailto:* | \#*) continue ;;
        esac
        if ! target="$(normalize_path "$dir/${link%%#*}")"; then
            echo "link to $link in $file points outside the repository" >&2
            exit 1
        fi
        queue+=("$target")
    done < <(grep -oE '\]\([^)[:space:]]+\)' "$repo_root/$file" | sed -E 's/^\]\((.*)\)$/\1/')
done

tar -C "$out_dir" -czf "$out_dir/$name.tar.gz" "$name"
(cd "$out_dir" && shasum -a 256 "$name.tar.gz" > "$name.tar.gz.sha256")
cat "$out_dir/$name.tar.gz.sha256"
