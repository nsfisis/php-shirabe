#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/vendor/autoload.php';

use Shirabe\Lint\Linters\CargoWorkspaceDependencies;
use Shirabe\Lint\Linters\ContiguousUseBlock;
use Shirabe\Lint\Linters\NoBannedUse;
use Shirabe\Lint\Linters\NoDecorativeSectionComment;
use Shirabe\Lint\Linters\NoDirectEnvAccess;
use Shirabe\Lint\Linters\NoExceptionDowncast;
use Shirabe\Lint\Linters\NoFormatTrailingComma;
use Shirabe\Lint\Linters\NoHaltCompilerLiteral;
use Shirabe\Lint\Linters\NoModRs;
use Shirabe\Lint\Linters\NoPhpDocTag;
use Shirabe\Lint\Linters\NoQualifiedCratePath;
use Shirabe\Lint\Linters\NoQualifiedPhpShimPath;
use Shirabe\Lint\Linters\NoRedundantModulePath;
use Shirabe\Lint\Linters\NoStdCollectionsMaps;
use Shirabe\Lint\Linters\NoSuperPath;
use Shirabe\Lint\Linters\NoUseAsAlias;
use Shirabe\Lint\Linters\OneUsePerModule;
use Shirabe\Lint\Linters\PhpSrcDerivationBoundary;
use Shirabe\Lint\Linters\PluginConstructibleList;
use Shirabe\Lint\Linters\PluginGeneratedStubs;
use Shirabe\Lint\Linters\PluginSurfaceManifest;
use Shirabe\Lint\Linters\RustHandleDescriptorConstruction;
use Shirabe\Lint\Linters\SortedDependencies;
use Shirabe\Lint\Linters\UpstreamFileHash;
use Shirabe\Lint\Runner;

$rootDir = dirname(__DIR__, 2);

$runner = new Runner($rootDir, [
    [new CargoWorkspaceDependencies(), []],
    [new ContiguousUseBlock(), []],
    [new NoBannedUse(), []],
    [new NoDecorativeSectionComment(), [
        'crates/shirabe-semver/src/version_parser.rs',
    ]],
    [new NoDirectEnvAccess(), [
        // Defines the shim the rule points at.
        'crates/shirabe-php-shim/src/env.rs',
        // Build scripts read Cargo's own variables, and run before the shim exists.
        'crates/shirabe-php-rpc/build.rs',
        'crates/shirabe/build.rs',
    ]],
    [new NoExceptionDowncast(), [
        // Defines the box and the walk the rule points at.
        'crates/shirabe-php-shim/src/exception.rs',
        // Downcast a panic payload, not an error: PHP's error handler throws an \ErrorException
        // where these call sites `catch` it.
        'crates/shirabe/src/cache.rs',
        'crates/shirabe/src/util/filesystem.rs',
    ]],
    [new NoFormatTrailingComma(), [
        'crates/shirabe/src/package/loader/root_package_loader.rs',
        'crates/shirabe-spdx-licenses/src/spdx_licenses.rs',
    ]],
    [new NoHaltCompilerLiteral(), [
        'crates/shirabe/build.rs',
    ]],
    [new NoModRs(), []],
    [new NoPhpDocTag(), []],
    [new NoQualifiedCratePath(), []],
    [new NoQualifiedPhpShimPath(), [
        // Generates code that expands in the caller's scope, as a `macro_rules!` body does.
        'crates/shirabe-php-shim-macros/src/lib.rs',
        // Newtypes named after the shim exception they wrap; the shim type cannot be imported
        // under its own name.
        'crates/shirabe-symfony-console/src/exception/invalid_argument_exception.rs',
        'crates/shirabe-symfony-console/src/exception/logic_exception.rs',
        'crates/shirabe-symfony-console/src/exception/runtime_exception.rs',
        'crates/shirabe-symfony-process/src/exception/invalid_argument_exception.rs',
        'crates/shirabe-symfony-process/src/exception/logic_exception.rs',
        'crates/shirabe-symfony-process/src/exception/runtime_exception.rs',
        'crates/shirabe-symfony-string/src/exception/invalid_argument_exception.rs',
    ]],
    [new NoRedundantModulePath(), []],
    [new NoStdCollectionsMaps(), []],
    [new NoSuperPath(), []],
    [new NoUseAsAlias(), []],
    [new OneUsePerModule(), []],
    [new PhpSrcDerivationBoundary(), []],
    [new PluginConstructibleList(), []],
    [new PluginGeneratedStubs(), []],
    [new PluginSurfaceManifest(), []],
    [new RustHandleDescriptorConstruction(), [
        // Defines `entity_value`, the one place the descriptor is built.
        'crates/shirabe/src/php_worker/rpc/entity.rs',
    ]],
    [new SortedDependencies(), []],
    [new UpstreamFileHash(), []],
]);

exit($runner->run() ? 0 : 1);
